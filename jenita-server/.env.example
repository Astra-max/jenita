# Server Port
PORT=8080

# SQLite Database Path
DATABASE_PATH=./jenita.db

# JWT Secret Key
JWT_SECRET=jenita-voice-secret-key-development-2026

# Google Gemini Live API Key
# Get a free key at https://aistudio.google.com
# If left empty, the server automatically runs in smart simulation mode
GEMINI_API_KEY=AIzaSyCpDK_oPmjADfpFVrt_TDjo4i6uDt5sK4U


# Gemini Model
# Prefer a supported Gemini Live model such as models/gemini-2.0-flash-live-001.
# The old experimental model string caused live WebSocket incompatibility.
GEMINI_MODEL=models/gemini-2.0-flash-live-001

# Gemini Voice Persona (Aoede, Puck, Charon, Kore, Fenrir)
VOICE_NAME=Aoede

# Max Reconnection Retries on disconnect
MAX_RECONNECT_RETRIES=5

# Environment (development / production)
ENVIRONMENT=development
